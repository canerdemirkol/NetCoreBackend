<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NetCoreBackend.NArchitecture.$(AssemblyName)</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>NetCoreBackend.NArchitecture.$(AssemblyName)</PackageId>
    <Version>1.0.1</Version>
    <Title>NetCoreBackend NArchitecture $(AssemblyName)</Title>
    <Description>DI registration for Core.Outbox.</Description>
    <Product>NetCoreBackend NArchitecture</Product>
    <Authors>Caner Demirkol, Contributors</Authors>
    <Company></Company>
    <PackageTags>Outbox, DI, NArchitecture</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core.Outbox\Core.Outbox.csproj" />
  </ItemGroup>
</Project>
