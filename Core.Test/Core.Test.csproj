<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NetCoreBackend.NArchitecture.$(AssemblyName)</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>NetCoreBackend.NArchitecture.$(AssemblyName)</PackageId>
    <Version>1.0.0</Version>
    <Title>NetCoreBackend NArchitecture $(AssemblyName)</Title>
    <Description>Test helpers (BaseFakeData, MockRepositoryHelper, BaseMockRepository) for consuming apps, plus the framework's own xUnit regression suite. Test SDK packages are PrivateAssets="all" so they never flow to consumers.</Description>
    <Product>NetCoreBackend NArchitecture</Product>
    <Authors>Caner Demirkol, Contributors</Authors>
    <Company></Company>
    <PackageTags>Clean Architecture, Union Architecture, Core, NArchitecture, Test, Unit Test,
      Integration Test, Testing, Mocking</PackageTags>
    <PackageIcon></PackageIcon>
    <RepositoryUrl></RepositoryUrl>
    <!-- NU5100: test DLL inside lib/ is by design — the project doubles as the framework's
         own xUnit runner via `dotnet test`. Consumers only consume the helper types
         (BaseFakeData, MockRepositoryHelper, ...); xUnit/SDK refs are PrivateAssets="all". -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <!-- Public dependencies — these flow to consumers as transitive references. -->
  <ItemGroup>
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <!-- Test runner deps. PrivateAssets="all" ensures the produced NuGet package doesn't
       drag xUnit / Microsoft.NET.Test.Sdk / coverlet into consumer apps. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="all" />
    <PackageReference Include="xunit" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="FluentValidation" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Application\Core.Application.csproj" />
    <ProjectReference Include="..\Core.Localization.Resource.Yaml\Core.Localization.Resource.Yaml.csproj" />
    <ProjectReference Include="..\Core.Persistence\Core.Persistence.csproj" />
    <ProjectReference Include="..\Core.MultiTenancy\Core.MultiTenancy.csproj" />
    <ProjectReference Include="..\Core.Security\Core.Security.csproj" />
    <ProjectReference Include="..\Core.Outbox\Core.Outbox.csproj" />
  </ItemGroup>
</Project>
