<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NetCoreBackend.NArchitecture.$(AssemblyName)</RootNamespace>
    <!--
      Core.Test framework'ün KENDİ regression test'lerini barındırır + tüketici test
      helper'larını (BaseFakeData, MockRepositoryHelper, BaseMockRepository) içerir.
      Test runner ile karışmasın diye paketlenmiyor; helpers'ı NuGet'ten dağıtmak
      istenirse ayrı bir Core.TestKit projesine taşımak daha temiz olur.
    -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Public dependencies — these flow to consumers as transitive references. -->
  <ItemGroup>
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <!-- Test runner deps. PrivateAssets="all" ensures the produced NuGet package doesn't
       drag xUnit / Microsoft.NET.Test.Sdk / coverlet into consumer apps. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" PrivateAssets="all" />
    <PackageReference Include="xunit" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="FluentValidation" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Mediation\Core.Mediation.csproj" />
    <ProjectReference Include="..\Core.Application\Core.Application.csproj" />
    <ProjectReference Include="..\Core.Localization.Resource.Yaml\Core.Localization.Resource.Yaml.csproj" />
    <ProjectReference Include="..\Core.Persistence\Core.Persistence.csproj" />
    <ProjectReference Include="..\Core.MultiTenancy\Core.MultiTenancy.csproj" />
    <ProjectReference Include="..\Core.Security\Core.Security.csproj" />
    <ProjectReference Include="..\Core.Outbox\Core.Outbox.csproj" />
  </ItemGroup>
</Project>
