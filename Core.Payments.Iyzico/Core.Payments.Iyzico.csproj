<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NetCoreBackend.NArchitecture.$(AssemblyName)</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>NetCoreBackend.NArchitecture.$(AssemblyName)</PackageId>
    <Version>1.0.0-preview.3</Version>
    <Title>NetCoreBackend NArchitecture $(AssemblyName)</Title>
    <Description>iyzico (Checkout Form) for Core.Payments: hosted payment page, result retrieval with response signatures, status query, cancel and refund over the IYZWSv2 HMAC API. Preview until verified in the sandbox.</Description>
    <Product>NetCoreBackend NArchitecture</Product>
    <Authors>Caner Demirkol, Contributors</Authors>
    <Company></Company>
    <PackageTags>Payments, iyzico, Virtual POS, NArchitecture</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core.Payments\Core.Payments.csproj" />
  </ItemGroup>
</Project>
