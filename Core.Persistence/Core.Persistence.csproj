<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NetCoreBackend.NArchitecture.$(AssemblyName)</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>NetCoreBackend.NArchitecture.$(AssemblyName)</PackageId>
    <Version>1.1.0</Version>
    <Title>NetCoreBackend NArchitecture $(AssemblyName)</Title>
    <Description>Provides persistence utilities for data access using Entity Framework Core.</Description>
    <Product>NetCoreBackend NArchitecture</Product>
    <Authors>Caner Demirkol, Contributors</Authors>
    <Company></Company>
    <PackageTags>Clean Architecture, Union Architecture, Core, NArchitecture, Persistence, Data
      Access, Repository Pattern, Entity Framework, Unit of Work, Database, ORM, NoSQL, Relational,
      File System</PackageTags>
    <PackageIcon></PackageIcon>
    <RepositoryUrl></RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Linq.Dynamic.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
  </ItemGroup>
</Project>